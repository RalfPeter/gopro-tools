<layout>
    <composite x="170" y="20" name="date_and_time">
        <component type="datetime" name="date_date" x="0" y="0" format="%d.%m.%Y" size="20" align="right"/>
        <component type="datetime" name="date_time" x="0" y="24" format="%H:%M:%S.%f" truncate="5" size="32" align="right"/>
    </composite>

    <composite x="2430" y="-10" name="gps_info">
        <frame name="gps-lock" x="226" y="24" width="32" height="32" bg="0,0,0,128" cr="5" opacity="0.4">
            <component type="gps-lock-icon" size="32"/>
         </frame>

        <composite y="35">
            <component type="text" x="0" y="0" size="16" align="left">GPS</component>
            <component type="text" x="0" y="24" size="16" align="left">Lat: </component>
            <component type="text" x="135" y="24" size="16" align="left">Lon: </component>
            <component type="metric" x="125" y="24" metric="lat" dp="6" size="20" align="right" cache="False"/>
            <component type="metric" x="255" y="24" metric="lon" dp="6" size="20" align="right" cache="False"/>
        </composite>
    </composite>

    <composite x="20" y="1250" name="big_mph">
<!--    <component type="metric_unit" metric="speed" units="speed" size="16">{:~c}</component>-->
        <component type="metric" x="0" y="0" metric="speed" units="speed" dp="0" size="160" />
    </composite>

    <translate x="0" y="1430">
        <composite x="220" y="0" name="gradient">
            <component type="text" x="70" y="0" size="20">Steigung</component>
            <component type="icon" x="0" y="0" file="slope-triangle.png" size="64"/>
            <component type="metric" x="70" y="18" metric="gradient" dp="0" size="32" />
        </composite>

        <composite x="16" y="0" name="altitude">
            <component type="metric_unit" x="70" y="0" metric="alt" units="alt" size="20">H&#246;he({:~C})</component>
            <component type="icon" x="0" y="0" file="mountain.png" size="64"/>
            <component type="metric" x="70" y="18" metric="alt" units="alt" dp="0" size="32" />
        </composite>

        <component type="chart" name="gradient_chart" x="400" y="0"/>
    </translate>

<!--<component type="moving_map" name="moving_map" x="2250" y="100" size="384" zoom="17" corner_radius="35" />-->
<!--<component type="journey_map" name="journey_map" x="2234" y="1134" size="350" corner_radius="35"/>-->

    <translate x="2284" y="1114">
<!--    <frame width="384" height="384" outline="255,0,0" opacity="0.6" cr="35" fo="40">-->
        <frame width="384" height="384" outline="255,0,0" opacity="0.6" cr="35">
            <component type="moving_journey_map" name="moving_journey_map" size="384" zoom="16"/>
        </frame>
    </translate>

<!--<translate x="2200" y="1100">
        <component type="circuit_map" name="circuit_map" size="384"/>
    </translate>-->
</layout>